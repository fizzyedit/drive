.{
    .name = .drive,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "plugin.zig",
        "plugin.zig.zon",
        "credentials.zon",
        "src",
        "web",
        "LICENSE",
        "README.md",
    },
    .fingerprint = 0x681df58f0316cd49,
    .dependencies = .{
        // Menu icons (lucide), the same set fizzy's own commands use.
        .icons = .{
            .url = "https://github.com/foxnne/zig-lib-icons/archive/db034786a1286ab28dc35aba534c098aa4f1a3aa.tar.gz",
            .hash = "icons-0.0.0-iJxA-VvGMwAgiKSXRe_Y0O7RpasdtEJhBfVx8IGGEBl_",
            .lazy = true,
        },
        // Locally the SDK next door; a release pins the `fizzy-sdk-v*` asset URL instead.
        .fizzy = .{
            // The published SDK, not a path into a checkout: a release has to build from a
            // clean clone, and the release asset (never the tag's git archive) is the SDK
            // package alone — the monorepo root zon carries the app's own dependencies.
            .url = "https://github.com/fizzyedit/fizzy/releases/download/sdk-v0.2.4/fizzy-sdk-v0.2.4.tar.gz",
            .hash = "fizzy-0.2.4-SGBwY8WrFgBJkNFVnrlPNvFzWSf4mEOwpbyNFsXg90_S",
        },
    },
}
