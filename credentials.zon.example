// The app's own Google OAuth clients — public identifiers, not any user's secret — baked into
// the plugin at build time so a user never types them. Copy to `credentials.zon` (gitignored)
// and fill in from the Google Cloud console (README › Publisher setup). `zig build` creates the
// file from FIZZY_DRIVE_CLIENT_ID / FIZZY_DRIVE_CLIENT_SECRET / FIZZY_DRIVE_WEB_CLIENT_ID when it
// is missing, which is how CI supplies them.
.{
    // OAuth client of type "Desktop app": what native fizzy signs in with.
    .client_id = "",
    // Its "secret". Google requires it at the token exchange even for desktop apps and treats
    // it as non-confidential for them; it grants nothing by itself.
    .client_secret = "",
    // OAuth client of type "Web application": what the web build signs in with.
    .web_client_id = "",
    // An API key (Credentials › Create credentials › API key): Google's folder picker requires
    // one beside the user's token. Restrict it to the Google Picker API.
    .api_key = "",
}
